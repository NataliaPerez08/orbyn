ORBYN_DB=./data/orbyn.db
# ORBYN_DB also accepts a PostgreSQL URL, e.g.:
# ORBYN_DB=postgres://orbyn@localhost:5432/orbyn?sslmode=require
# Password for a PostgreSQL URL that omits one (kept out of argv):
# ORBYN_PG_PASSWORD=
ORBYN_LOG=orbyn=warn
ORBYN_NMAP_BIN=nmap
ORBYN_SNMP_BIN=snmpwalk
ORBYN_SNMP_COMMUNITY=public
ORBYN_SSH_BIN=ssh
ORBYN_CURL_BIN=curl
ORBYN_NETBOX_TOKEN=
# Prometheus bearer token for `orbyn prometheus import` (kept out of argv):
ORBYN_PROMETHEUS_TOKEN=
# Zabbix API token for `orbyn zabbix import` (kept out of argv):
ORBYN_ZABBIX_TOKEN=
# Proxmox API token (`user@realm!tokenid=secret`) for `orbyn proxmox import`:
ORBYN_PROXMOX_TOKEN=
# AWS credentials for `orbyn aws import` (kept out of argv):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=eu-west-1
# AWS_ENDPOINT_URL=
# Huawei Cloud credentials for `orbyn huawei import` (kept out of argv):
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
# HUAWEICLOUD_REGION=cn-north-4
# HUAWEICLOUD_PROJECT_ID=
# OpenStack scoped Keystone token for `orbyn openstack import`:
ORBYN_OPENSTACK_TOKEN=
# OS_PROJECT_ID=
# OS_REGION_NAME=
# GCP OAuth bearer token and project for `orbyn gcp import`:
ORBYN_GCP_TOKEN=
# GOOGLE_CLOUD_PROJECT=
# Azure AD bearer token and subscription for `orbyn azure import`:
ORBYN_AZURE_TOKEN=
# AZURE_SUBSCRIPTION_ID=
# WinRM Basic-auth password for --collector winrm (kept out of argv):
ORBYN_WINRM_PASSWORD=
