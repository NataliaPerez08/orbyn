ORBYN_DB=./data/orbyn.db
# ORBYN_DB also accepts a PostgreSQL URL, e.g.:
# ORBYN_DB=postgres://orbyn@localhost:5432/orbyn?sslmode=require
# Password for a PostgreSQL URL that omits one (kept out of argv):
# ORBYN_PG_PASSWORD=
ORBYN_LOG=orbyn=warn
ORBYN_NMAP_BIN=nmap
ORBYN_SNMP_BIN=snmpwalk
ORBYN_SNMP_COMMUNITY=public
ORBYN_SSH_BIN=ssh
ORBYN_CURL_BIN=curl
ORBYN_NETBOX_TOKEN=
# Prometheus bearer token for `orbyn prometheus import` (kept out of argv):
ORBYN_PROMETHEUS_TOKEN=
# WinRM Basic-auth password for --collector winrm (kept out of argv):
ORBYN_WINRM_PASSWORD=
