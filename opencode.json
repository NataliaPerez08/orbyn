{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "plugin": ["@dietrichgebert/ponytail"],

  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HuaweiCloudMaaS",
      "options": {
        "baseURL": "https://api-ap-southeast-1.modelarts-maas.com/openai/v1"
      },
      "models": {
        "glm-5.3": {
          "name": "glm-5.3",
          "limit": {
            "context": 196608,
            "output": 8192
          }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": {
            "context": 196608,
            "output": 8192
          }
        },
        "glm-5.1": {
          "name": "glm-5.1",
          "limit": {
            "context": 196608,
            "output": 8192
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 196608,
            "output": 8192
          }
        }
      }
    }
  }
}
